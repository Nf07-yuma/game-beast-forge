rules_version = '2';

// Beast Forge cloud sync rules.
//
// There is no per-user login — any authenticated (including anonymous)
// client can read/write any players/{key} document. What scopes access to a
// given save is the document key itself: the app derives it client-side as
// SHA-256(syncCode + ":" + password) (see src/cloud/sync.ts), so knowing the
// 8-character sync code alone isn't enough to read or overwrite someone
// else's save — the password (never stored anywhere, including here) is
// also required to reproduce the key. This is a deliberate, low-friction
// tradeoff appropriate for casual game data; it is not suitable for
// anything sensitive.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{key} {
      allow read, write: if request.auth != null;
    }
  }
}
