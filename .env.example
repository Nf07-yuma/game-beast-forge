# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase console → Project settings → Your apps → SDK setup
# and configuration). These are client-side config values, not secrets — see
# README.md's "クラウド同期" section for full setup steps and Firestore
# security rules (firestore.rules).
#
# Leaving these unset simply disables cloud sync; the rest of the app works
# fully offline as before.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
